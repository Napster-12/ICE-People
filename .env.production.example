# ICE People Administration System: production settings.
# Copy to .env on the server (never commit .env), fill in every CHANGE_ME, and keep it readable only by the app user
# (chmod 600 .env). Values here are examples.
#
# First deploy, from the project folder:
#   pip install -r requirements.txt
#   flask db upgrade                       # creates the tables in Postgres
#   flask seed-reference-data              # roles, occupational levels, holidays, approval chains, templates
#   flask create-user ictadmin --email ict@icebolethu.co.za --name "ICT Administrator" --role IT
#   gunicorn --workers 3 --bind 127.0.0.1:8000 run:app
# Moving files from an existing server's disk to S3 (once): flask upload-files-to-s3 --from-folder /path/to/uploads

# ------------------------------------------------------------------ app
APP_ENV=production
FLASK_APP=run.py
# Never set FLASK_DEBUG here: the debugger lets anyone run code on the server (production ignores it anyway).
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
# Encrypts ID numbers, bank details and the Take-On form at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you move existing data across, use the SAME key as before: data encrypted with another key can't be read.
# Keep a copy in a password manager or AWS Secrets Manager; losing it loses that data.
FERNET_KEY=CHANGE_ME

# The address people use. Email buttons, offer links and consent links are built from it.
PUBLIC_BASE_URL=https://CHANGE_ME.icebolethu.co.za

# ------------------------------------------------------------------ database (PostgreSQL)
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE   (postgres:// and postgresql:// are accepted too)
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
# sslmode=require encrypts the connection (AWS RDS supports it out of the box).
DATABASE_URL=postgresql+psycopg://ice_people:CHANGE_ME@CHANGE_ME.af-south-1.rds.amazonaws.com:5432/ice_people?sslmode=require

# ------------------------------------------------------------------ files (Amazon S3)
# Every upload and generated PDF (CVs, ID copies, contracts, offer letters, background check reports...) goes to
# this bucket. Keep the bucket PRIVATE (Block Public Access on): people download through the app, which checks
# their permissions. Files are encrypted at rest.
FILE_STORAGE=s3
S3_BUCKET=CHANGE_ME-ice-people-files
S3_PREFIX=uploads
AWS_REGION=af-south-1
# Optional: a KMS key (ID, ARN or alias/...) for SSE-KMS. Blank uses S3-managed encryption (AES-256).
S3_KMS_KEY_ID=
# Credentials: best is an IAM role on the server (EC2 instance profile / ECS task role) with s3:PutObject,
# s3:GetObject, s3:DeleteObject on arn:aws:s3:::BUCKET/uploads/* and s3:ListBucket on the bucket (plus
# kms:Encrypt/Decrypt/GenerateDataKey if you set S3_KMS_KEY_ID). Then leave these two out.
# Only if the server has no role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------ security
# HTTPS only (cookies are never sent over plain HTTP).
SESSION_COOKIE_SECURE=1
# Proxies in front of the app (AWS load balancer, nginx): 1 for one of them, 2 for a load balancer plus nginx,
# 0 if people reach gunicorn directly. Needed for real client IPs (sign-in rate limit, audit log) and HTTPS links.
PROXY_FIX_HOPS=1
# Failed sign-ins allowed per IP.
LOGIN_RATE_LIMIT=10 per minute
# Rate-limit counters. memory:// is per gunicorn worker; with several workers or servers use Redis
# (e.g. AWS ElastiCache):  redis://CHANGE_ME:6379/0
RATELIMIT_STORAGE_URI=memory://

# ------------------------------------------------------------------ email
# smtp sends real email; anything else only prints (mock).
MAIL_PROVIDER=smtp
# A company mailbox, not a personal one. Office 365: smtp.office365.com, 587 (STARTTLS).
# Gmail / Google Workspace: smtp.gmail.com, 587, with an app password.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@icebolethu.co.za
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME@icebolethu.co.za
SMTP_FROM_NAME=ICE People Administration System
# Every email is BCC'd here. Leave EMPTY in production: emails carry applicants' and staff's personal information
# (POPIA). Use it only on a test system.
EMAIL_COPY_TO=
# Send in the background so pages don't wait for the mail server.
EMAIL_ASYNC=1
INTEGRATION_RETRIES=2
