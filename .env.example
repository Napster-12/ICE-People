# Copy this file to .env and fill in the values. Never commit .env.

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts ID numbers and bank details. Keep it safe: data can't be read without it.
FERNET_KEY=

# development | production
APP_ENV=development
FLASK_APP=run.py

# Default: SQLite in instance/hr.db. Examples:
#   SQL Server:  mssql+pyodbc://user:pass@server/IcebolethuHR?driver=ODBC+Driver+18+for+SQL+Server
#   PostgreSQL:  postgresql+psycopg://user:pass@localhost/icebolethu_hr
DATABASE_URL=

# Where uploads are stored (outside /static). Default: instance/uploads
UPLOAD_FOLDER=

# Set to 1 when served over HTTPS (always in production)
SESSION_COOKIE_SECURE=0

# Password given to every test user by seed.py (development only)
SEED_PASSWORD=Icebolethu@Test2026

# The original recruitment portal database, read by `flask import-legacy`
LEGACY_DB=portal.db
